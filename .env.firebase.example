# Copy to .env.firebase.local after creating the new Firebase project.
VITE_BACKEND_PROVIDER=firebase
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_CONSOLE_STORAGE_BUCKET
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID
VITE_FIREBASE_API_BASE_URL=https://REPLACE_PROJECT_ID.web.app/api
VITE_PUBLIC_APP_URL=https://REPLACE_PROJECT_ID.web.app/real-life-quest
# Web OAuth client ID from the NEW project's Google sign-in provider, NOT Android client ID.
VITE_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_NEW_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# Local emulators only (never include this flag in a Play build):
# VITE_FIREBASE_EMULATORS=true
